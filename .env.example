# ---- server (apps/server) ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# postgres://user:pass@host:5432/db  |  pglite://./.data/pglite (embedded, dev)  |  pglite://memory (tests)
DATABASE_URL=pglite://./.data/pglite
DATABASE_POOL_SIZE=20
# required in production, >= 32 characters
JWT_SECRET=change-me-change-me-change-me-change-me
# comma separated allowed browser origins for REST + WebSocket ("*" only in development)
CORS_ORIGINS=http://localhost:5173
ALLOW_TEACHER_SIGNUP=true
# serve the built web client from the server (production single-origin deployment)
WEB_DIST=
# horizontal scaling: unique node id + URL other nodes redirect clients to
NODE_ID=battle-1
NODE_PUBLIC_URL=
SESSION_LEASE_TTL_MS=15000
SESSION_IDLE_UNLOAD_MS=600000
WS_HEARTBEAT_MS=15000
LEADERBOARD_SNAPSHOT_MS=5000
TIMESTAMP_TRUST_WINDOW_MS=1000
AUTH_RATE_LIMIT_PER_MIN=20
API_RATE_LIMIT_PER_MIN=600
LOG_LEVEL=info

# ---- web (apps/web, build time) ----
# empty = same origin (recommended); set when the API lives on another host
VITE_API_URL=
VITE_WS_URL=
# dev proxy target for `npm run dev:web`
BRAINBATTLE_SERVER=http://localhost:4000

# ---- desktop (apps/desktop) ----
BRAINBATTLE_URL=http://localhost:4000
